# Copy to .env. Unset keys just disable that provider in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
# Plugins ("package.module:Class"). Leave empty for the built-in no-op.
# Built-ins: gateway.plugins.redis_cache:RedisCache (+ GATEWAY_REDIS_URL), gateway.plugins.rules_router:RulesRouter (JJ)
GATEWAY_CACHE_CLASS=
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_ROUTER_CLASS=
GATEWAY_ROUTER_NAME=JJ
